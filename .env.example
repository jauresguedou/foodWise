# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
# Use your own Neon branch; never share one dev database across the team.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (same host without "-pooler"). Used by Prisma migrations.
# connect_timeout gives a suspended Neon database time to wake up.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Integration tests only. Must point at localhost; the test setup wipes it.
# Matches compose.yaml, so `npm run db:test:up` is all you need.
TEST_DATABASE_URL="postgresql://foodwise:foodwise@localhost:5433/foodwise_test"
