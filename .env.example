# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
# Use your own Neon branch; never share one dev database across the team.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (same host without "-pooler"). Used by Prisma migrations.
# connect_timeout gives a suspended Neon database time to wake up.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Better Auth. Generate a secret with: npx @better-auth/cli secret
# (or: openssl rand -base64 32). Use a different one in each environment.
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
# The URL you open the app at, no trailing slash. Locally that is
# http://localhost:3000. On Vercel, set it for Production only (the stable
# production domain); previews fall back to VERCEL_URL automatically.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated school domains. A verified address on one of these (or a
# subdomain) gets student prices.
STUDENT_EMAIL_DOMAINS="byupathway.edu"
EMAIL_TRANSPORT="console"

# Brevo delivery. Verify the sender address in Brevo before using it.
BREVO_API_KEY=""
EMAIL_FROM="FoodWise <signin@your-verified-domain.example>"

# Optional alternative provider.
RESEND_API_KEY=""

# Integration tests only. Must point at localhost; the test setup wipes it.
# Matches compose.yaml, so `npm run db:test:up` is all you need.
TEST_DATABASE_URL="postgresql://foodwise:foodwise@localhost:5433/foodwise_test"
